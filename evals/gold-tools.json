{
  "version": 1,
  "description": "Hand-calculated cases. Each runs a real tool through the MCP server and checks the listed fields. Sources are the IRS rule the expected value comes from.",
  "cases": [
    {
      "id": "res-01",
      "question": "I'm on an H-1B and was in the U.S. 183 days in 2026, none before. Am I a resident?",
      "tool": "check_tax_residency",
      "args": {
        "taxYear": 2026,
        "status": "other",
        "daysCurrent": 183,
        "daysPrior1": 0,
        "daysPrior2": 0
      },
      "expect": { "result": "resident", "weightedDays": 183 },
      "source": "https://www.irs.gov/individuals/international-taxpayers/substantial-presence-test"
    },
    {
      "id": "res-02",
      "question": "120 days in each of 2024, 2025 and 2026 on a work visa. Resident?",
      "tool": "check_tax_residency",
      "args": {
        "taxYear": 2026,
        "status": "other",
        "daysCurrent": 120,
        "daysPrior1": 120,
        "daysPrior2": 120
      },
      "expect": { "result": "nonresident", "weightedDays": 180 },
      "source": "https://www.irs.gov/individuals/international-taxpayers/substantial-presence-test"
    },
