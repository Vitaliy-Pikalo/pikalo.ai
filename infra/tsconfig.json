{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["../*"] }
  },
  "include": ["bin", "lib", "lambda", "test", "../lib/ingest"]
}
